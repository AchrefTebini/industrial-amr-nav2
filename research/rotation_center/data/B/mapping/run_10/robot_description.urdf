<!-- Industrial AMR: rectangular chassis, two drive wheels, two passive
     casters, a 2D LIDAR and an RGB camera.

     use_sim:=true adds the Gazebo sensors and system plugins.
     use_sim:=false gives the plain kinematic description, for real hardware
     or RViz only.

     Units are metres, kg and kg*m^2. -->
<robot name="industrial_amr">
  <!-- base_footprint is on the ground directly below base_link, the usual
       convention for navigation stacks. Both sit on the drive-axle midpoint,
       the point a differential drive turns about, so odometry, Nav2's motion
       models and the footprint all refer to the true centre of rotation. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link is at the height of the chassis bottom and the axle, so
         the wheels touch the ground. -->
    <origin rpy="0 0 0" xyz="0 0 0.075"/>
  </joint>
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.2 0 0.075"/>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.2 0 0.075"/>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.2 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.15208333333333335" ixy="0" ixz="0" iyy="0.31875" iyz="0" izz="0.4333333333333333"/>
    </inertial>
  </link>
  <link name="left_wheel_link">
    <visual>
      <!-- A cylinder's axis is Z by default. Rotate it onto Y, the axle. -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0007697916666666666" ixy="0" ixz="0" iyy="0.0007697916666666666" iyz="0" izz="0.00140625"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.225 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>
  <link name="right_wheel_link">
    <visual>
      <!-- A cylinder's axis is Z by default. Rotate it onto Y, the axle. -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0007697916666666666" ixy="0" ixz="0" iyy="0.0007697916666666666" iyz="0" izz="0.00140625"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.0 -0.225 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>
  <link name="front_left_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="caster_white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4.900000000000002e-05" ixy="0" ixz="0" iyy="4.900000000000002e-05" iyz="0" izz="4.900000000000002e-05"/>
    </inertial>
  </link>
  <joint name="front_left_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_caster_link"/>
    <!-- The ground is at z = -wheel_radius in base_link, so this puts the
           bottom of the sphere on the ground. -->
    <origin rpy="0 0 0" xyz="0.42000000000000004                    0.12                    -0.039999999999999994"/>
  </joint>
  <gazebo reference="front_left_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="front_right_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="caster_white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4.900000000000002e-05" ixy="0" ixz="0" iyy="4.900000000000002e-05" iyz="0" izz="4.900000000000002e-05"/>
    </inertial>
  </link>
  <joint name="front_right_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_caster_link"/>
    <!-- The ground is at z = -wheel_radius in base_link, so this puts the
           bottom of the sphere on the ground. -->
    <origin rpy="0 0 0" xyz="0.42000000000000004                    -0.12                    -0.039999999999999994"/>
  </joint>
  <gazebo reference="front_right_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.0 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010666666666666665" ixy="0" ixz="0" iyy="0.00010666666666666665" iyz="0" izz="0.00016"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.4 0 0.16999999999999998"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
      <material name="camera_red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="6.083333333333333e-05" ixy="0" ixz="0" iyy="1.4999999999999999e-05" iyz="0" izz="6.083333333333333e-05"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.515 0 0.075"/>
  </joint>
  <!-- Images use the ROS optical convention: Z forward, X right, Y down. -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <!-- 80 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <gz_frame_id>camera_optical_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- Harmonic plugin names have no "lib" prefix and no ".so" suffix. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <!-- Gazebo topics, bridged to ROS by industrial_amr_gazebo/config/bridge.yaml -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>
  <!-- robot_state_publisher needs the wheel joint states for the wheel TFs. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
