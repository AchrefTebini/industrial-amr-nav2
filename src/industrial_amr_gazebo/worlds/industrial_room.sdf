<?xml version="1.0" ?>
<!-- A 10 x 8 m room with static obstacles and a charging station, for
     mapping and navigation tests. The origin is the room centre and the
     inside of the walls runs from (-5, -4) to (5, 4). The robot spawns at
     the origin. -->
<sdf version="1.9">
  <world name="industrial_room">

    <physics name="1kHz" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <!-- Without this the robot's gpu_lidar and camera publish nothing. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <light type="directional" name="factory_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.4 -0.3 -0.8</direction>
    </light>


    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- Walls are 0.2 m thick, centred 0.1 m outside the room boundary so the
         inner faces sit exactly on it. -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="obstacle_crate_large">
      <static>true</static>
      <pose>-2.5 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.45 0.25 1</ambient>
            <diffuse>0.6 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_crate_small">
      <static>true</static>
      <pose>1.5 -2.8 0.3 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.2 1</ambient>
            <diffuse>0.55 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_barrel_1">
      <static>true</static>
      <pose>0.5 0.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1</ambient>
            <diffuse>0.15 0.35 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_barrel_2">
      <static>true</static>
      <pose>3.5 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.15 0.15 1</ambient>
            <diffuse>0.5 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_pillar">
      <static>true</static>
      <pose>-1.0 -1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- L-shaped partition made of two boxes. -->
    <model name="obstacle_partition_h">
      <static>true</static>
      <pose>-3.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.4 0.4 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_partition_v">
      <static>true</static>
      <pose>-3.725 -1.375 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.1 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.4 0.4 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Charging station in the (+X, +Y) corner. It is built from brightly
         coloured shapes (green base, yellow back panel, red guide rails, blue
         beacon) so a camera-based dock detector can recognise it later. -->

    <model name="charger_base">
      <static>true</static>
      <pose>4.2 3.2 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.0 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.0 0.10</size></box></geometry>
          <material>
            <ambient>0.1 0.65 0.2 1</ambient>
            <diffuse>0.1 0.65 0.2 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="charger_back_panel">
      <static>true</static>
      <pose>4.2 3.65 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.08 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.08 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.75 0.1 1</ambient>
            <diffuse>0.85 0.75 0.1 1</diffuse>
            <specular>0.4 0.4 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="charger_rail_left">
      <static>true</static>
      <pose>3.7 3.35 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.06 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="charger_rail_right">
      <static>true</static>
      <pose>4.7 3.35 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.06 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="charger_beacon">
      <static>true</static>
      <pose>4.2 3.65 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
            <specular>0.5 0.5 0.8 1</specular>
            <emissive>0.05 0.15 0.5 1</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
