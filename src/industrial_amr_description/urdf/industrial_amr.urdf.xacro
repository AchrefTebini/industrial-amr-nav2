<?xml version="1.0"?>
<!-- Industrial AMR: rectangular chassis, two drive wheels, two passive
     casters, a 2D LIDAR and an RGB camera.

     use_sim:=true adds the Gazebo sensors and system plugins.
     use_sim:=false gives the plain kinematic description, for real hardware
     or RViz only.

     Units are metres, kg and kg*m^2. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_amr">

  <xacro:arg name="use_sim" default="true" />
  <xacro:property name="use_sim" value="$(arg use_sim)" />

  <xacro:include filename="$(find industrial_amr_description)/urdf/properties.xacro" />
  <xacro:include filename="$(find industrial_amr_description)/urdf/inertial_macros.xacro" />
  <xacro:include filename="$(find industrial_amr_description)/urdf/base.xacro" />
  <xacro:include filename="$(find industrial_amr_description)/urdf/sensors.xacro" />

  <xacro:if value="${use_sim}">
    <xacro:include filename="$(find industrial_amr_description)/urdf/gazebo.xacro" />
  </xacro:if>

</robot>
