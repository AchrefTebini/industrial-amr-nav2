<?xml version="1.0"?>
<!-- Mobile base: base_footprint, chassis, drive wheels and casters. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- base_footprint is on the ground directly below base_link, the usual
       convention for navigation stacks. Both sit on the drive-axle midpoint,
       the point a differential drive turns about, so odometry, Nav2's motion
       models and the footprint all refer to the true centre of rotation. -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child  link="base_link" />
    <!-- base_link is at the height of the chassis bottom and the axle, so
         the wheels touch the ground. -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>


  <link name="base_link">
    <visual>
      <origin xyz="${chassis_x} 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="${chassis_x} 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>

    <!-- Centre of mass under the chassis centre, at base_link height. -->
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"
                       xyz="${chassis_x} 0 0" />
  </link>


  <!-- prefix: "left" or "right". y_reflect: 1 for left (+Y), -1 for right. -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <!-- A cylinder's axis is Z by default. Rotate it onto Y, the axle. -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="${wheel_mass}"
                              r="${wheel_radius}"
                              h="${wheel_width}"
                              rpy="${pi/2} 0 0" />
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child  link="${prefix}_wheel_link" />
      <origin xyz="${chassis_x + wheel_x_offset} ${y_reflect * wheel_y_offset} 0"
              rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.01" friction="0.1" />
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1"  />
  <xacro:drive_wheel prefix="right" y_reflect="-1" />


  <!-- Casters are frictionless spheres on fixed joints. They slide instead
       of rolling, the usual simplification for diff-drive casters in
       simulation. -->
  <xacro:macro name="caster_wheel" params="prefix x_sign y_sign">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="caster_white">
          <color rgba="0.9 0.9 0.9 1.0" />
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>

      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child  link="${prefix}_caster_link" />
      <!-- The ground is at z = -wheel_radius in base_link, so this puts the
           bottom of the sphere on the ground. -->
      <origin xyz="${chassis_x + x_sign * caster_x_offset}
                   ${y_sign * caster_y_offset}
                   ${-wheel_radius + caster_radius}"
              rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster_wheel prefix="front_left"  x_sign="1" y_sign="1"  />
  <xacro:caster_wheel prefix="front_right" x_sign="1" y_sign="-1" />


</robot>
