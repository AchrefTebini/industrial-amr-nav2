<?xml version="1.0"?>
<!-- Robot dimensions. The Nav2 footprint and sensor ranges (marked "URDF:" in
     industrial_amr_navigation/config) come from these values; keep them in sync. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_length"  value="0.60" />
  <xacro:property name="chassis_width"   value="0.40" />
  <xacro:property name="chassis_height"  value="0.15" />
  <xacro:property name="chassis_mass"    value="10.0" />

  <xacro:property name="wheel_radius"    value="0.075"/>
  <xacro:property name="wheel_width"     value="0.04" />
  <xacro:property name="wheel_mass"      value="0.5"  />
  <xacro:property name="wheel_x_offset"  value="-0.20"/>   <!-- rear-wheel drive -->
  <xacro:property name="wheel_y_offset"  value="${chassis_width/2 + wheel_width/2 + 0.005}" />

  <xacro:property name="caster_radius"   value="0.035"/>
  <xacro:property name="caster_mass"     value="0.1"  />
  <xacro:property name="caster_x_offset" value="0.22" />
  <xacro:property name="caster_y_offset" value="0.12" />

  <!-- Sensor z values are in base_link, which is the chassis bottom. -->
  <xacro:property name="lidar_radius" value="0.04" />
  <xacro:property name="lidar_length" value="0.04" />
  <xacro:property name="lidar_x"  value="0.20" />
  <xacro:property name="lidar_z"  value="${chassis_height + lidar_length/2}" />
  <xacro:property name="lidar_range_min" value="0.12" />
  <xacro:property name="lidar_range_max" value="12.0" />

  <xacro:property name="camera_size_x" value="0.03" />
  <xacro:property name="camera_size_y" value="0.08" />
  <xacro:property name="camera_size_z" value="0.03" />
  <xacro:property name="camera_x" value="${chassis_length/2 + camera_size_x/2}" />
  <xacro:property name="camera_z" value="${chassis_height/2}" />


</robot>
